{
  "manifest_version": 3,
  "name": "Internee Scout 🇪🇬 | Feed Internship Detector",
  "version": "1.0.0",
  "description": "Auto-scouts and self-reports Egyptian student internships while browsing LinkedIn and X (Twitter) feeds.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internee Scout Settings & Stats",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
