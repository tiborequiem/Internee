# Turso Database (Set these in Vercel Project Settings > Environment Variables)
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Fallback for local development if not using Turso
DATABASE_URL="file:local.db"

# Admin Secret for moderating community submissions (/admin)
ADMIN_SECRET="pick-a-strong-passcode"

# Cron Secret for securing /api/cron/scrape endpoint
CRON_SECRET="pick-a-random-secret"
